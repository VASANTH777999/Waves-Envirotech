# Copy to .env for local dev, and set the same keys as Environment Variables
# in your Vercel project settings (Project -> Settings -> Environment Variables).
#
# Example using a Gmail account with an "App Password"
# (Google Account -> Security -> 2-Step Verification -> App Passwords):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password

# Optional - defaults to SMTP_USER if not set
SMTP_FROM=your-email@gmail.com

# Where contact/career/newsletter notifications are sent
MAIL_TO=syreddy@wavesenviro.com
